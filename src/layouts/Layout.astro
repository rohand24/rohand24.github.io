---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { siteConfig } from '../data/siteConfig.js';

const { title, description } = Astro.props;
const pageTitle = title ? `${title} | ${siteConfig.site.title}` : siteConfig.site.title;
const metaDescription = description ?? siteConfig.site.description;
const base = import.meta.env.BASE_URL;
const faviconPath = siteConfig.assets?.favicon ?? '/favicon.svg';
const faviconHref = faviconPath.startsWith('/')
  ? `${base}${faviconPath.replace(/^\//, '')}`
  : `${base}${faviconPath}`;
const cloudflareWebAnalyticsToken = siteConfig.integrations?.cloudflareWebAnalyticsToken;
const hasCloudflareWebAnalytics =
	typeof cloudflareWebAnalyticsToken === 'string' &&
	cloudflareWebAnalyticsToken.trim() &&
	!cloudflareWebAnalyticsToken.startsWith('TODO');
---

<!doctype html>
<html lang={siteConfig.site.language ?? 'en'}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href={faviconHref} />
		<meta name="description" content={metaDescription} />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Inter:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<div class="page">
			<Header />
			<main>
				<slot />
			</main>
			<Footer />
		</div>
		{hasCloudflareWebAnalytics && (
			<script
				defer
				src="https://static.cloudflareinsights.com/beacon.min.js"
				data-cf-beacon={JSON.stringify({ token: cloudflareWebAnalyticsToken.trim() })}
			></script>
		)}
	</body>
</html>

<style>
	:global(:root) {
		color-scheme: light;

		/* — Ink & text — */
		--ink:         #0f172a;   /* slate-900 */
		--muted:       #475569;   /* slate-600 */
		--muted-light: #94a3b8;   /* slate-400 */

		/* — Brand accents — */
		--accent:      #0f766e;   /* teal-700  — primary CTA, links */
		--accent-dark: #0d5f58;   /* teal-800  — hover state */
		--accent-soft: #f0fdfa;   /* teal-50   — tag fill */
		--accent-2:    #1e40af;   /* blue-800  — secondary accent */
		--accent-2-soft: #eff6ff; /* blue-50 */

		/* — Surfaces — */
		--surface:     #ffffff;
		--bg:          #f8fafc;   /* slate-50 */
		--border:      rgba(15, 23, 42, 0.09);
		--shadow-sm:   0 1px 3px rgba(15, 23, 42, 0.06), 0 2px 6px rgba(15, 23, 42, 0.05);
		--shadow:      0 2px 8px rgba(15, 23, 42, 0.07), 0 8px 24px rgba(15, 23, 42, 0.07);
		--radius:      10px;
	}

	:global(html) {
		scroll-behavior: smooth;
	}

	:global(body) {
		margin: 0;
		min-height: 100%;
		font-family: 'Inter', system-ui, sans-serif;
		font-size: 1rem;
		line-height: 1.6;
		color: var(--ink);
		background: var(--bg);
	}

	:global(*) {
		box-sizing: border-box;
	}

	:global(a) {
		color: inherit;
		text-decoration: none;
	}

	/* Headings use the serif display face */
	:global(h1),
	:global(h2),
	:global(h3) {
		font-family: 'DM Serif Display', Georgia, serif;
		font-weight: 400; /* DM Serif Display is naturally bold at 400 */
		margin: 0 0 0.5rem;
		letter-spacing: -0.01em;
		color: var(--ink);
		line-height: 1.2;
	}

	:global(h4),
	:global(h5),
	:global(h6) {
		font-family: 'Inter', system-ui, sans-serif;
		font-weight: 600;
		margin: 0 0 0.4rem;
		color: var(--ink);
	}

	:global(p) {
		color: var(--muted);
		line-height: 1.7;
		margin: 0 0 1rem;
	}

	:global(code) {
		font-family: 'IBM Plex Mono', 'Fira Code', monospace;
		font-size: 0.875em;
		background: var(--accent-soft);
		padding: 0.1em 0.4em;
		border-radius: 4px;
		color: var(--accent);
	}

	/* ── Page wrapper ──────────────────────────────────────── */
	.page {
		position: relative;
		min-height: 100vh;
	}

	main {
		padding: 2rem 1.5rem 4rem;
		max-width: 1100px;
		margin: 0 auto;
	}

	/* ── Utility classes ───────────────────────────────────── */
	:global(.section) {
		margin: 3rem 0;
	}

	/* Eyebrow: small uppercase label above a heading */
	:global(.eyebrow) {
		text-transform: uppercase;
		font-size: 0.72rem;
		letter-spacing: 0.14em;
		font-weight: 600;
		color: var(--accent);
		margin-bottom: 0.35rem;
	}

	/* Primary button — teal */
	:global(.button) {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.65rem 1.25rem;
		border-radius: 6px;
		font-family: 'Inter', sans-serif;
		font-weight: 600;
		font-size: 0.875rem;
		background: var(--accent);
		color: #ffffff;
		letter-spacing: 0.01em;
		transition: background 0.18s ease, transform 0.15s ease, box-shadow 0.18s ease;
		box-shadow: 0 1px 4px rgba(15, 118, 110, 0.3);
	}

	:global(.button:hover) {
		background: var(--accent-dark);
		transform: translateY(-1px);
		box-shadow: 0 4px 12px rgba(15, 118, 110, 0.3);
	}

	/* Secondary button — outlined */
	:global(.button.secondary) {
		background: var(--surface);
		color: var(--ink);
		border: 1px solid var(--border);
		box-shadow: var(--shadow-sm);
	}

	:global(.button.secondary:hover) {
		background: var(--bg);
		border-color: rgba(15, 23, 42, 0.2);
		transform: translateY(-1px);
		box-shadow: var(--shadow);
	}

	/* Card */
	:global(.card) {
		background: var(--surface);
		border-radius: var(--radius);
		border: 1px solid var(--border);
		padding: 1.5rem 1.75rem;
		box-shadow: var(--shadow-sm);
	}

	/* Tags */
	:global(.tag) {
		display: inline-flex;
		align-items: center;
		padding: 0.2rem 0.65rem;
		border-radius: 4px;
		background: var(--accent-soft);
		font-size: 0.73rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		color: var(--accent);
		border: 1px solid rgba(15, 118, 110, 0.15);
	}

	:global(.tag.alt) {
		background: var(--accent-2-soft);
		color: var(--accent-2);
		border-color: rgba(30, 64, 175, 0.15);
	}

	/* Grid */
	:global(.grid) {
		display: grid;
		gap: 1.5rem;
	}

	/* Divider line */
	:global(.divider) {
		border: none;
		border-top: 1px solid var(--border);
		margin: 2rem 0;
	}

	/* Responsive */
	@media (min-width: 720px) {
		main {
			padding: 3rem 2rem 5rem;
		}

		:global(.grid.two) {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 640px) {
		:global(.button) {
			width: 100%;
			justify-content: center;
		}
	}
</style>
