---
import Layout from '../layouts/Layout.astro';
import { loadProjects } from '../data/projects.js';

const projects = await loadProjects();
---

<Layout title="Projects">
	<section class="section">
		<p class="eyebrow">Projects</p>
		<h1>Research projects &amp; initiatives</h1>
	</section>

	<section class="section proj-grid">
		{projects.map((project) => {
			const validLinks = (project.links ?? []).filter(
				(link) => typeof link.url === 'string' && !link.url.startsWith('TODO')
			);
			const pendingLinks = (project.links ?? []).some(
				(link) => typeof link.url !== 'string' || link.url.startsWith('TODO')
			);

			return (
				<details class="card project-card">
					<summary class="project-summary-trigger">
						<div class="project-header">
							<p class="eyebrow">{project.timeframe}</p>
							<h2>{project.title}</h2>
							<p class="project-subtitle">{project.subtitle}</p>
						</div>
						<span class="expand-hint"><span class="when-closed">▸ click to expand</span><span class="when-open">▾ click to collapse</span></span>
					</summary>

					<div class="project-body">
						<p class="project-desc">{project.summary}</p>

						{project.highlights && project.highlights.length > 0 && (
							<ul class="project-highlights">
								{project.highlights.map((item) => (
									<li>{item}</li>
								))}
							</ul>
						)}

						<div class="project-footer">
							<div class="tag-list">
								{project.tags?.map((tag) => (
									<span class="tag">{tag}</span>
								))}
							</div>
							{(validLinks.length > 0 || pendingLinks) && (
								<div class="project-links">
									{validLinks.map((link) => (
										<a href={link.url} target="_blank" rel="noopener noreferrer">{link.label} &rarr;</a>
									))}
									{pendingLinks && <span class="pending">Links available on request</span>}
								</div>
							)}
						</div>
					</div>
				</details>
			);
		})}
	</section>
</Layout>

<style>
	.proj-grid {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.project-card {
		display: block;
	}

	/* Collapsible details/summary */
	details.project-card > summary {
		list-style: none;
		cursor: pointer;
		display: block;
	}

	details.project-card > summary::-webkit-details-marker {
		display: none;
	}

	.project-summary-trigger {
		display: flex;
		flex-direction: column;
	}

	details.project-card > summary:hover h2 {
		color: var(--accent);
		transition: color 0.15s ease;
	}

	.expand-hint {
		display: block;
		font-size: 0.75rem;
		font-weight: 500;
		color: var(--muted-light);
		letter-spacing: 0.04em;
		margin-top: 0.35rem;
	}

	.expand-hint .when-open {
		display: none;
	}

	details[open] > summary .when-closed {
		display: none;
	}

	details[open] > summary .when-open {
		display: inline;
	}

	.project-body {
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
		margin-top: 1rem;
		padding-top: 1rem;
		border-top: 1px solid var(--border);
	}

	.project-header {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
	}

	.project-header .eyebrow {
		margin-bottom: 0.2rem;
	}

	.project-header h2 {
		font-size: 1.35rem;
		margin: 0;
	}

	.project-subtitle {
		margin: 0;
		color: var(--muted);
		font-size: 0.95rem;
	}

	.project-desc {
		color: var(--muted);
		font-size: 0.95rem;
		line-height: 1.7;
		text-align: justify;
		margin: 0;
	}

	.project-highlights {
		margin: 0;
		padding-left: 1.2rem;
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
	}

	.project-highlights li {
		color: var(--muted);
		font-size: 0.9rem;
		line-height: 1.55;
	}

	.project-footer {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		margin-top: 0.25rem;
	}

	.tag-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	.project-links {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
	}

	.project-links a {
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--accent);
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	.project-links a:hover {
		color: var(--accent-dark);
	}

	.pending {
		font-size: 0.85rem;
		color: var(--muted-light);
		font-style: italic;
	}
</style>
